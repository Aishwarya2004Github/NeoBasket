# Copy DATABASE_URL from your existing NeoBasket server/.env
DATABASE_URL=

# Optional: enables natural-language Copilot, recipe generation and image analysis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

AI_PORT=8002
AI_CORS_ORIGIN=http://localhost:5173

# Copy the value of SECRET_KEY_ACCESS_TOKEN from server/.env
ACCESS_TOKEN_SECRET=
