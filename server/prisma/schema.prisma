generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid())

  name String

  email String @unique

  password String

  avatar String?

  mobile String?

  refresh_token String?

  forgot_password_expiry DateTime?

  forgot_password_otp String?

  last_login_date DateTime?

  role UserRole @default(USER)

  status UserStatus @default(Active)

  verify_email Boolean @default(false)

  addresses Address[]

  cartProducts CartProduct[]

  orders Order[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Address {
  id String @id @default(uuid())

  address_line String

  city String

  state String

  pincode String

  country String

  mobile String?

  status Boolean @default(true)

  userId String

  user User @relation(fields: [userId], references: [id])

  orders Order[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Category {
  id String @id @default(uuid())

  name String

  image String

  subCategories SubCategory[]

  products Product[]
}

model SubCategory {
  id String @id @default(uuid())

  name String

  image String

  categoryId String

  category Category @relation(fields: [categoryId], references: [id])

  products Product[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Product {
  id String @id @default(uuid())

  name String

  image String[]

  categoryId String
  subCategoryId String

  category Category @relation(fields: [categoryId], references: [id])
  subCategory SubCategory @relation(fields: [subCategoryId], references: [id])

  unit String?

  quantity Int @default(0)
  stock Int @default(0)

  price Float?
  discount Float?
  description String?
  more_details Json?

  manufacturingDate DateTime?
  expiryDate DateTime?

  publish Boolean @default(true)

  cartProducts CartProduct[]
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model CartProduct {
  id String @id @default(uuid())

  quantity Int @default(1)

  productId String

  userId String

  product Product @relation(fields: [productId], references: [id])

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
  @@unique([userId, productId])
}


model Order {
  id                  String   @id @default(uuid())
  userId              String
  orderId             String

  productId           String
  product_name        String
  product_image       Json?

  paymentId           String?
  payment_status      String?
  status              String   @default("PENDING")

  delivery_addressId  String
  quantity            Int      @default(1)

  subTotalAmt         Float    @default(0)
  totalAmt            Float    @default(0)

  stockDeducted       Boolean  @default(false)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  confirmedAt          DateTime?
  packedAt             DateTime?
  shippedAt            DateTime?
  dispatchedAt         DateTime?
  outForDeliveryAt     DateTime?
  deliveredAt          DateTime?

  cancelledAt          DateTime?
  cancelledBy          String?
  cancelReason         String?

  deliveryPartnerId    String?

  user                 User              @relation(fields: [userId], references: [id])
  product              Product           @relation(fields: [productId], references: [id])
  delivery_address     Address           @relation(fields: [delivery_addressId], references: [id])
  deliveryPartner      DeliveryPartner?  @relation(fields: [deliveryPartnerId], references: [id])
}

model DeliveryPartner {

  id String @id @default(uuid())

  employeeId String @unique

  name String

  age Int

  gender String

  mobile String

  email String @unique

  password String

  address String

  photo String?

  orders Order[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}

enum UserStatus {
  Active

  Inactive

  Suspended
}

enum UserRole {
  ADMIN

  USER
}

enum OrderStatus {
  PENDING

  ACCEPTED

  PACKED

  SHIPPED

  DISPATCHED

  OUT_FOR_DELIVERY

  DELIVERED

  CANCELLED
}
